# StarWaves WhatsApp Worker — local env
# Copy to .env and adjust. DO NOT commit .env (contains local paths)
# NOTE: CGO_ENABLED is a Go toolchain flag, NOT an app env var.
# On Windows you must run with CGO_ENABLED=1 (requires GCC/mingw):
#   $env:CGO_ENABLED=1; go run main.go   (PowerShell)
#   set CGO_ENABLED=1 && go run main.go  (cmd)
#   make run / .\run.ps1
# Docker already sets it in Dockerfile.

PORT=3001
DATA_DIR=./data
BACKEND_WEBHOOK_URL=http://127.0.0.1:8000/api/v1/whatsapp/webhook
# For production docker, use: http://server:8000/api/v1/whatsapp/webhook
