{
  "crons": [
    {
      "path": "/api/v1/cron/process-jobs",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "http://13.203.228.229/api/v1/:path*"
    },
    {
      "source": "/health",
      "destination": "http://13.203.228.229/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
