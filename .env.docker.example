# StarWaves Docker Server Environment Configuration Example
# Copy this file to server/.env or .env before running docker compose up

APP_NAME="StarWaves API"
APP_ENV="production"
API_V1_PREFIX="/api/v1"
# Frontend (canonical): https://starwaves.susindran.in — preview aliases remain for Vercel PR deploys
# Vercel default https://starwaves.vercel.app is 308-redirected to canonical (see vercel.json redirects)
CORS_ORIGINS="http://localhost,http://localhost:5173,https://starwaves.susindran.in,https://starwaves.vercel.app,https://*.vercel.app,http://34.0.0.0"

# Database (PostgreSQL / Supabase)
DATABASE_URL="postgresql+asyncpg://starwaves:starwaves_password@postgres:5432/starwaves"

# Firebase Authentication Credentials
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY_ID="your-private-key-id"
FIREBASE_CLIENT_ID="your-client-id"

# OAuth Integrations
GITHUB_OAUTH_CLIENT_ID="your-github-client-id"
GITHUB_OAUTH_CLIENT_SECRET="your-github-client-secret"
GITHUB_OAUTH_STATE_SECRET="your-github-state-secret"

GOOGLE_OAUTH_CLIENT_ID="your-google-client-id"
GOOGLE_OAUTH_CLIENT_SECRET="your-google-client-secret"
GOOGLE_OAUTH_STATE_SECRET="your-google-state-secret"

# Frontend (canonical) — all email links + OAuth postMessage targetOrigin use this
FRONTEND_URL="https://starwaves.susindran.in"
# Backend API (canonical) — frontend calls this directly (no Vercel proxy)
VITE_API_URL="https://api.starwaves.susindran.in/api/v1"
AUTH_SECRET_KEY="starwaves-super-secret-auth-key-change-in-prod"  # generate: openssl rand -base64 48

# EVE AI Assistant (any configured provider may be selected by users)
DEFAULT_AI_PROVIDER="openrouter"
OPENAI_API_KEY="sk-proj-..."
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-sonnet-4-5"
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"
# OpenRouter (300+ models behind one key) — https://openrouter.ai/keys
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/free"
# OpenRouter TTS — Fish Audio S2.1 Pro Free (free) via POST /audio/speech (OpenAI-compatible)
# Get a key at https://openrouter.ai/keys; voice is per-model (alloy for default)
OPENROUTER_TTS_MODEL="fish-audio/s2.1-pro-free:free"
OPENROUTER_TTS_VOICE="alloy"
# Ollama (local models, no key needed; point at your Ollama server's OpenAI-compatible endpoint)
# OLLAMA_URL="http://host.docker.internal:11434/v1"
OLLAMA_MODEL="llama3.1"
# OpenCode — https://opencode.ai
OPENCODE_API_KEY=""
OPENCODE_MODEL="opencode/gpt-5-mini"

# SMTP Mail Server (Brevo — recommended)
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER="a2301b001@smtp-brevo.com"
SMTP_PASSWORD="your-brevo-smtp-master-password-or-xsmtpsib-key"
SMTP_FROM_EMAIL="noreply@starwaves.susindran.in"
SMTP_USE_TLS="true"
SMTP_USE_SSL="false"

# VM Runtime (e2-micro lean, 1-10 users)
# Ubuntu host: create 1G swap first — sudo fallocate -l 1G /swapfile && sudo mkswap /swapfile && sudo swapon /swapfile
REDIS_URL="redis://redis:6379/0"
WORKSPACE_STORAGE_PATH="/app/workspaces"
CRON_SECRET="change-me-starwaves-cron-secret"

# Studio (Eve Builder) — optional wildcard preview domain (e.g. build.starwaves.susindran.in).
# Requires wildcard DNS + TLS; leave empty to use path-based preview URLs.
STUDIO_PREVIEW_DOMAIN=""
STUDIO_COMMAND_TIMEOUT="300"
DATABASE_URL_VM="postgresql+asyncpg://starwaves:starwaves_password@postgres:5432/starwaves"
# WARNING: workspace-data / postgres-data / whatsapp-data are VM local volumes.
# `docker compose down -v` WILL DELETE all user workspaces + DB. Use `docker compose down` without -v. No backup cron on free tier.

# Vercel Frontend (separate domain)
# VITE_API_URL="https://api.starwaves.susindran.in/api/v1"
# VITE_WS_URL="wss://api.starwaves.susindran.in"
