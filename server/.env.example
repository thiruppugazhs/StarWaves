APP_NAME=StarWaves API
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=https://starwaves.susindran.in,http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=https://starwaves.susindran.in

# Option A: Unwrapped Firebase Service Account Credentials (No file needed on serverless/cloud)
FIREBASE_PROJECT_ID=susindran
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@susindran.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_CLIENT_ID=
FIREBASE_CLIENT_X509_CERT_URL=
FIRESTORE_DATABASE_ID=(default)

# Option B: Or point to a JSON file path on disk:
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\firebase-service-account.json

# Auth & Google Cloud OAuth 2.0 (User Sign-In, Gmail, Calendar, Drive)
AUTH_SECRET_KEY=starwaves-super-secret-auth-key-change-in-prod

# Eve AI Assistant (keep this server-side; never expose it in VITE_ variables)
DEFAULT_AI_PROVIDER=openrouter
OPENAI_API_KEY=your-openai-api-key
OPENAI_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=your-gemini-api-key
GEMINI_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=your-groq-api-key
GROQ_URL=https://api.groq.com/openai/v1
GROQ_STT_MODEL=whisper-large-v3-turbo
# Deepgram — fastest cloud STT (~200-300ms), powers Eve voice <1s turns
DEEPGRAM_API_KEY=your-deepgram-api-key
DEEPGRAM_STT_URL=https://api.deepgram.com/v1/listen
DEEPGRAM_STT_MODEL=nova-3
GOOGLE_CLOUD_TTS_API_KEY=your-google-cloud-tts-api-key
GOOGLE_CLOUD_TTS_URL=https://texttospeech.googleapis.com/v1
GOOGLE_CLOUD_TTS_VOICE=en-US-Standard-C
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TTS_MODEL=fish-audio/s2.1-pro-free:free
OPENROUTER_TTS_VOICE=alloy
OPENROUTER_TTS_URL=https://openrouter.ai/api/v1
# Ollama — local default is http://127.0.0.1:11434/v1 ; for cloud set OLLAMA_URL to your cloud endpoint
OLLAMA_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3.1
OPENCODE_API_KEY=your-opencode-api-key
OPENCODE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=gpt-5.4-mini
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_STATE_SECRET=replace-with-random-secret
AUTH_GOOGLE_CALLBACK_URL=http://127.0.0.1:8000/api/v1/auth/google/callback
GOOGLE_OAUTH_CALLBACK_URL=http://127.0.0.1:8000/api/v1/integrations/google-calendar/callback
GOOGLE_DRIVE_OAUTH_CALLBACK_URL=http://127.0.0.1:8000/api/v1/integrations/google-drive/callback
GMAIL_OAUTH_CALLBACK_URL=http://127.0.0.1:8000/api/v1/integrations/gmail/callback
GOOGLE_CHAT_OAUTH_CALLBACK_URL=http://127.0.0.1:8000/api/v1/integrations/google-chat/callback
GOOGLE_CONTACTS_OAUTH_CALLBACK_URL=http://127.0.0.1:8000/api/v1/integrations/google-contacts/callback

# GitHub OAuth App
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_STATE_SECRET=replace-with-random-secret
GITHUB_OAUTH_CALLBACK_URL=http://127.0.0.1:8000/api/v1/integrations/github/callback

# SMTP Email Configuration (Brevo — smtp-relay.brevo.com via STARTTLS on 587; legacy alias smtp-relay.sendinblue.com)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-login-like-a2301b001@smtp-brevo.com
SMTP_PASSWORD=your-brevo-smtp-master-password-or-xsmtpsib-key
SMTP_FROM_EMAIL=noreply@starwaves.susindran.in
SMTP_USE_TLS=true
SMTP_USE_SSL=false
CRON_SECRET=replace-with-secure-random-secret

# Twilio PSTN Calling — dual call option (in_app WebRTC vs Twilio phone)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+14155551234
TWILIO_CALLBACK_BASE_URL=http://127.0.0.1:8000
# Or https://api.starwaves.susindran.in for production
