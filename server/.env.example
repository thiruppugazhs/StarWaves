APP_NAME=StarWaves API
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=https://starwaves.app,https://starwaves.vercel.app,http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# ==============================================================================
# 1. DATABASE: Firebase Cloud Firestore (Primary Engine)
# ==============================================================================
# Option A: Paste Firebase Service Account fields directly (Ideal for Vercel/Render/Cloud deployment):
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_CLIENT_ID=
FIREBASE_CLIENT_X509_CERT_URL=
FIRESTORE_DATABASE_ID=(default)

# Option B: Or point to service account JSON file on your machine:
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\firebase-service-account.json

# Offline Fallback (Auto-activated when Firebase credentials are not set):
# SQLite file: database.db will be used automatically.

# ==============================================================================
# 2. STARWAVES BUILT-IN AI (Powered by Google Gemini)
# ==============================================================================
# Built-in AI key provided by host so users can get started instantly for free:
DEFAULT_AI_PROVIDER=gemini
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash

# Optional BYOK Provider Keys (Server fallback / users can supply their own):
OPENAI_API_KEY=your-openai-api-key
OPENAI_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5
GROQ_API_KEY=your-groq-api-key
GROQ_URL=https://api.groq.com/openai/v1
GROQ_STT_MODEL=whisper-large-v3-turbo
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o
OLLAMA_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.1

# ==============================================================================
# 3. SPEECH & VOICE SERVICES
# ==============================================================================
# Google Cloud Text-to-Speech:
GOOGLE_CLOUD_TTS_API_KEY=your-google-cloud-tts-api-key
GOOGLE_CLOUD_TTS_URL=https://texttospeech.googleapis.com/v1
GOOGLE_CLOUD_TTS_VOICE=en-US-Standard-C

# Deepgram STT (Optional fast speech-to-text):
DEEPGRAM_API_KEY=your-deepgram-api-key

# ==============================================================================
# 4. EMAIL SERVICE (SMTP for 6-Digit Email OTP & Verification)
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-username@gmail.com
SMTP_PASSWORD=your-smtp-app-password
SMTP_FROM_EMAIL=noreply@starwaves.app
SMTP_USE_TLS=true

# ==============================================================================
# 5. GOOGLE OAUTH 2.0 (Google Login, Calendar, Gmail, Drive)
# ==============================================================================
AUTH_SECRET_KEY=generate-a-secure-random-secret-key-for-session-tokens
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_STATE_SECRET=replace-with-random-secret
AUTH_GOOGLE_CALLBACK_URL=http://127.0.0.1:8000/api/v1/auth/google/callback
GOOGLE_OAUTH_CALLBACK_URL=http://127.0.0.1:8000/api/v1/integrations/google-calendar/callback
GOOGLE_DRIVE_OAUTH_CALLBACK_URL=http://127.0.0.1:8000/api/v1/integrations/google-drive/callback
GMAIL_OAUTH_CALLBACK_URL=http://127.0.0.1:8000/api/v1/integrations/gmail/callback
GOOGLE_CHAT_OAUTH_CALLBACK_URL=http://127.0.0.1:8000/api/v1/integrations/google-chat/callback
GOOGLE_CONTACTS_OAUTH_CALLBACK_URL=http://127.0.0.1:8000/api/v1/integrations/google-contacts/callback

# GitHub Integration
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_STATE_SECRET=replace-with-random-secret
GITHUB_OAUTH_CALLBACK_URL=http://127.0.0.1:8000/api/v1/integrations/github/callback

# Background Cron
CRON_SECRET=replace-with-secure-random-secret
